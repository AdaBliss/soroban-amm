{
  "name": "@soroban-amm/ts-advanced-client",
  "version": "0.1.0",
  "description": "Chainable middleware client for Soroban transactions",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": ["lib"],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "clean": "rm -rf lib",
    "lint": "eslint ."
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@stellar/stellar-sdk": ">=12.0.0"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=12.0.0"
  },
  "peerDependenciesMeta": {
    "@stellar/stellar-sdk": {
      "optional": true
    }
  }
}
